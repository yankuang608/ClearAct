{
  "name": "clearact",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "test": "node --import tsx --test packages/*/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node --import tsx scripts/build-packages.ts",
    "server": "node packages/server/dist/cli.js",
    "mcp": "node packages/mcp/dist/cli.js",
    "check:packages": "node --import tsx scripts/check-packages.ts",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=HEAD",
    "version:packages": "changeset version",
    "release:check": "pnpm changeset:status && pnpm test && pnpm typecheck && pnpm build && pnpm check:packages",
    "release:publish": "node scripts/release-publish.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "18.3.7",
    "@types/ws": "^8.5.0",
    "element-plus": "2.11.5",
    "react-dom": "18.3.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "ajv": "^8.17.1",
    "playwright": "^1.55.0",
    "react": "^18.3.1",
    "vue": "^3.5.0",
    "ws": "^8.18.0"
  },
  "license": "MIT"
}
